{
  // Static-assets-only Worker: no "main", so Cloudflare serves ./site directly.
  "name": "netbird-presentation",
  "compatibility_date": "2026-08-27",

  "assets": {
    "directory": "./site"
  },

  // Matches the configuration generated by the last dashboard deployment,
  // so wrangler does not overwrite those settings on each deploy.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
